{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DirtSprintCars Historical Results Row",
  "description": "One row = one driver's result in one session (qualifying, heat, dash, B/C/D main, A-main) of one event-night. Blank (null) when no source verifies. Conflicts go in 'flags' with both values + sources.",
  "type": "object",
  "required": ["result_id","event_id","event_name","date","track","series","class","session","position","driver","source_url"],
  "properties": {
    "result_id":   {"type":"string","description":"event_id + session + position, e.g. 2026-knoxville-nationals-n4|A|1"},
    "event_id":    {"type":"string","description":"slug: year-event, e.g. 2026-knoxville-nationals"},
    "event_name":  {"type":"string","description":"Official name as published, e.g. 65th NOS Energy Drink Knoxville Nationals"},
    "edition":     {"type":["integer","null"],"description":"e.g. 65 (Knoxville), 43 (Kings Royal), 84 (Turkey Night)"},
    "event_tier":  {"type":"string","enum":["crown_jewel","major","national_tour","regional","weekly"]},
    "date":        {"type":"string","format":"date","description":"Local date the session ran (Knoxville 2026 A-main finished after midnight; use scheduled program date and note)"},
    "night":       {"type":["string","null"],"description":"e.g. Prelim 1, Knight Before, Finale"},
    "track":       {"type":"string"}, "city": {"type":"string"}, "state_country": {"type":"string"},
    "surface_length": {"type":["string","null"],"description":"e.g. 1/2-mile dirt oval"},
    "series":      {"type":["string","null"],"description":"Sanction, e.g. World of Outlaws Sprint Car Series; USAC National Midget"},
    "class":       {"type":"string","enum":["410 sprint","360 sprint","305 sprint","midget","non-wing sprint","silver crown","other"]},
    "session":     {"type":"string","enum":["practice","time_trials","heat","dash","last_chance","D-main","C-main","B-main","semi","A-main","other"]},
    "session_label":{"type":["string","null"],"description":"As published: 'Heat 3', 'Last Chance Showdown', 'Hard Knox'"},
    "scheduled_laps":{"type":["integer","null"]},
    "position":    {"type":["integer","null"],"description":"Finish position; for time_trials = rank"},
    "start":       {"type":["integer","null"]},
    "car_number":  {"type":["string","null"],"description":"String: keep letters (21T, 7BC, 39M)"},
    "driver":      {"type":"string","description":"Name as published by the official source"},
    "driver_id":   {"type":["string","null"],"description":"Stable slug, e.g. kyle-larson; join key for per-driver pages"},
    "hometown":    {"type":["string","null"]},
    "car_owner":   {"type":["string","null"]},
    "laps_completed":{"type":["integer","null"]},
    "laps_led":    {"type":["integer","null"]},
    "lap_leader_ranges":{"type":["string","null"],"description":"e.g. 1-50 or 28-65;67-69;75-98"},
    "status":      {"type":["string","null"],"description":"Running / DNF / DNS / DQ"},
    "time_or_margin":{"type":["string","null"],"description":"Qual time 12.140 or margin -0.949"},
    "points":      {"type":["integer","null"]},
    "purse_usd":   {"type":["integer","null"]},
    "transfer":    {"type":["boolean","null"]},
    "source_url":  {"type":"string","format":"uri"},
    "source2_url": {"type":["string","null"],"format":"uri","description":"Second independent source (dual-source rule)"},
    "verified":    {"type":"boolean","description":"true only if two sources agree"},
    "flags":       {"type":["string","null"],"description":"Conflict notes: 'laps 40 sched / 41 run (GWC) per WoO'"},
    "updated":     {"type":"string","format":"date"}
  }
}
